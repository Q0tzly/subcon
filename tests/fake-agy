#!/bin/bash
# Stand-in for agy in tests (linked as `agy` on PATH). Behaviour comes from FAKE_AGY_MODE:
#   ok       append "fake change" to the ticket's first ## Files entry, report done
#   outside  like ok, plus create outside.txt
#   commit   like ok, then commit
#   partial  change nothing, report partial
#   fail     exit 3 without output
#   sleep    wait FAKE_AGY_SLEEP seconds (default 3), then like ok
#   error    change the file, then print an ERROR result with a conversation_id and exit 1
#   killed   change the file, print only the stream-json init event, exit 137 (SIGKILL)
#   error_noconv  exit 1 without any output
# FAKE_AGY_LOG, when set, gets "PWD=<cwd>" and "FLAGS=<args except the prompt>".
set -euo pipefail

if [[ "${1:-}" == models ]]; then
  printf 'gemini-3.8-flash-medium\tGemini 3.8 Flash (Medium)\n'
  printf 'gemini-3.8-flash-high\tGemini 3.8 Flash (High)\n'
  exit 0
fi

prompt="" flags=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -p|--print|--prompt) prompt="$2"; shift ;;
    *) flags+=("$1") ;;
  esac
  shift
done
if [[ -n "${FAKE_AGY_LOG:-}" ]]; then
  { echo "PWD=$PWD"; echo "FLAGS=${flags[*]:-}"; } >> "$FAKE_AGY_LOG"
fi
[[ -n "$prompt" ]] || { echo "fake-agy: no prompt" >&2; exit 64; }

first_file="$(awk '/^## /{ f = ($0 ~ /^## Files/); next }
  f && /^[-*][[:space:]]/ { sub(/^[-*][[:space:]]+/, ""); gsub(/`/, ""); print; exit }' <<<"$prompt")"

# A resumed run gets no ticket (the real agy remembers it): continue on the file already changed.
if [[ -z "$first_file" && " ${flags[*]:-} " == *" --conversation "* ]]; then
  first_file="$(git status --porcelain | awk 'NR == 1 { print $2 }')"
fi

stream=0
[[ " ${flags[*]:-} " == *" stream-json "* ]] && stream=1
# emit <json>: print agy's final JSON, as a stream-json result event when asked to stream.
emit() {
  if [[ $stream -eq 1 ]]; then
    jq -cn --arg c conv-fake-1 '{event: "init", conversation_id: $c}'
    jq -c '{event: "result", result: .}' <<<"$1"
  else
    echo "$1"
  fi
}

report() {
  emit "$(jq -cn --arg s "$1" '{status: "SUCCESS", conversation_id: "conv-fake-1", duration_seconds: 1.5,
    usage: {input_tokens: 100, output_tokens: 20, total_tokens: 120, cache_read_tokens: 30, thinking_tokens: 10},
    structured_output: {status: $s, summary: "fake",
    files_changed: [], commands_run: [], design_questions: [], issues_found: []}}')"
}
change() {
  mkdir -p "$(dirname "$first_file")"
  echo "fake change" >> "$first_file"
}

case "${FAKE_AGY_MODE:-ok}" in
  ok) change; report done ;;
  layout)
    if [[ -d .git ]]; then echo "git-layout: clone" >> "$first_file"; else echo "git-layout: worktree" >> "$first_file"; fi
    if git status --porcelain >/dev/null 2>&1; then echo "git-works: yes" >> "$first_file"; else echo "git-works: no" >> "$first_file"; fi
    report done ;;
  outside) change; echo x > outside.txt; report done ;;
  commit)
    change
    git add -A
    git -c user.name=fake -c user.email=fake@example.invalid commit -qm fake
    report done ;;
  partial) report partial ;;
  fail) echo "fake-agy: failing" >&2; exit 3 ;;
  sleep) sleep "${FAKE_AGY_SLEEP:-3}"; change; report done ;;
  error)
    change
    emit '{"status":"ERROR","conversation_id":"conv-fake-1","error":"fake network error"}'
    exit 1 ;;
  killed)
    change
    [[ $stream -eq 1 ]] && jq -cn '{event: "init", conversation_id: "conv-fake-1"}'
    exit 137 ;;
  error_noconv) echo "fake-agy: failing" >&2; exit 1 ;;
  *) echo "fake-agy: unknown mode ${FAKE_AGY_MODE}" >&2; exit 64 ;;
esac
