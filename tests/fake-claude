#!/bin/bash
# Stand-in for claude (Claude Code) in tests, linked as `claude` on PATH.
# Behaviour comes from FAKE_CLAUDE_MODE:
#   ok     append "fake change" to the ticket's first ## Files entry, print a
#          success envelope with a structured_output report, exit 0
#   error  change the file, print an is_error envelope, exit 1
#   nojson print non-JSON garbage, exit 1
# `claude auth status` always reports a signed-in user.
set -euo pipefail

if [[ "${1:-}" == "auth" ]]; then
  echo '{"loggedIn": true, "authMethod": "claude.ai"}'
  exit 0
fi

session="" resume="" prompt=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --session-id) session="$2"; shift 2 ;;
    --resume) resume="$2"; shift 2 ;;
    --model|--output-format|--permission-mode|--allowedTools|--json-schema|--mcp-config) shift 2 ;;
    -p|--print|--strict-mcp-config) shift ;;
    --*) shift ;;
    *) prompt="$1"; shift ;;
  esac
done
[[ -n "$resume" ]] && session="$resume"
[[ -n "$session" ]] || session="fake-session-1"

mode="${FAKE_CLAUDE_MODE:-ok}"
if [[ "$mode" == "nojson" ]]; then
  echo "this is not json"
  exit 1
fi

# A resumed run gets no ticket (the session remembers it): continue on the
# file already changed.
if [[ -n "$resume" ]]; then
  f="$(git status --porcelain | awk 'NR == 1 { print $2 }')"
else
  f="$(awk '/^## /{ f = ($0 ~ /^## Files/); next }
    f && /^[-*][[:space:]]/ { sub(/^[-*][[:space:]]+/, ""); gsub(/`/, ""); print; exit }' <<<"$prompt")"
fi
echo "fake change" >> "$f"

if [[ "$mode" == "error" ]]; then
  jq -cn --arg s "$session" '{type: "result", subtype: "error_during_execution", is_error: true, result: "fake claude error", session_id: $s, duration_ms: 500, total_cost_usd: 0.005, usage: {input_tokens: 5, output_tokens: 6, cache_read_input_tokens: 7, cache_creation_input_tokens: 0}}'
  exit 1
fi

jq -cn --arg s "$session" --arg f "$f" '{type: "result", subtype: "success", is_error: false, result: "done", session_id: $s, duration_ms: 1234, total_cost_usd: 0.01, usage: {input_tokens: 10, output_tokens: 20, cache_read_input_tokens: 30, cache_creation_input_tokens: 0}, structured_output: {status: "done", summary: "fake claude did it", files_changed: [$f], commands_run: [], design_questions: [], issues_found: []}}'
