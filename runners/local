#!/bin/bash
set -euo pipefail

job_dir="${1:?job directory required}"
[[ "$job_dir" = /* ]] || job_dir="$(pwd)/$job_dir"
[[ -d "$job_dir" ]] || { echo "runners/local: job directory not found: $job_dir" >&2; exit 1; }

# Resolved before cd: $0 may be relative to the caller's directory.
driver_bin="$(cd "$(dirname "$0")/.." && pwd)/drivers/${SUBCON_DRIVER:-agy}"

cd "$job_dir/work"
exec "$driver_bin" "$job_dir"
