#!/bin/bash
# agy driver: runs the job's prompt with agy in the current directory (the job's work/).
# Usage: drivers/agy <job-dir>. The caller (a runner) has already cd'd into work/.
set -euo pipefail

if ! command -v agy >/dev/null 2>&1 && [[ -n "${HOME:-}" && -x "$HOME/.local/bin/agy" ]]; then
  export PATH="$HOME/.local/bin${PATH:+:$PATH}"
fi

# Auxiliary subcommands used by the host (lib/common.sh); they never start a job.
case "${1:-}" in
  preflight)
    command -v agy >/dev/null 2>&1 || {
      echo "agy not found: install agy and make sure it is on PATH or at ~/.local/bin/agy" >&2
      exit 1
    }
    exit 0
    ;;
  models) exec agy models ;;
  default-model) echo gemini-3.8-flash-medium; exit 0 ;;
esac

job_dir="${1:?job directory required}"
[[ "$job_dir" = /* ]] || job_dir="$(pwd)/$job_dir"

# Headless agy auto-denies anything not allowed, which aborts the whole run,
# so allow every command and deny the ones that change git state or reach out.
# Rules match whole words as a prefix: command(git commit) covers "git commit -m x".
# agy has no CLI setting to forbid BypassSandbox, and command(*) also approves
# unsandboxed runs; the deny list applies to those too.
settings='{"permissions":{
  "allow":["command(*)"],
  "deny":[
    "command(git commit)","command(git add)","command(git reset)","command(git checkout)",
    "command(git switch)","command(git restore)","command(git stash)","command(git rebase)",
    "command(git merge)","command(git push)","command(git clean)","command(git branch)",
    "command(git tag)","command(git rm)","command(git mv)","command(gh)","command(sudo)",
    "command(rm -rf)","command(rm -fr)"
  ]}}'

# Set for a resumed job: continue that agy conversation instead of starting a new one.
resume_flags=()
[[ -z "${SUBCON_CONVERSATION:-}" ]] || resume_flags=(--conversation "$SUBCON_CONVERSATION")

# stream-json emits the conversation_id in its first event, so a run that is killed
# before agy writes its final result can still be resumed.
stream="$job_dir/agy.stream"
rc=0
agy -p "$(cat "$SUBCON_PROMPT_FILE")" \
  ${resume_flags[@]+"${resume_flags[@]}"} \
  --model "$SUBCON_JOB_MODEL" \
  --mode accept-edits \
  --sandbox \
  --settings "$settings" \
  --output-format stream-json \
  --json-schema "$SUBCON_SCHEMA" \
  --disable-slash-commands \
  --print-timeout "$SUBCON_TIMEOUT" > "$stream" || rc=$?

# agy.json keeps the shape of `--output-format json`: the final result event's payload.
{ jq -c 'select(.event == "result") | .result' "$stream" 2>/dev/null || true; } | tail -n 1 > "$job_dir/agy.json"
if [[ ! -s "$job_dir/agy.json" ]]; then
  conversation="$({ jq -r 'select(.event == "init") | .conversation_id' "$stream" 2>/dev/null || true; } | head -n 1)"
  if [[ -n "$conversation" ]]; then
    jq -cn --arg c "$conversation" '{status: "ERROR", conversation_id: $c, error: "agy exited without a result"}' > "$job_dir/agy.json"
  else
    rm -f "$job_dir/agy.json"
  fi
fi
exit "$rc"
