#!/bin/bash
# Hand implementation tickets to Gemini Flash as jobs. See docs/design/v2.md.
set -euo pipefail

SELF="$0"
while [[ -L "$SELF" ]]; do SELF="$(readlink "$SELF")"; done
SUBCON_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
export SUBCON_ROOT

for f in common ticket job query manage history stats; do
  # shellcheck source=/dev/null
  source "$SUBCON_ROOT/lib/$f.sh"
done

usage() {
  cat >&2 <<USAGE
usage: subcon new <feature>/<NN-name>
       subcon submit [--runner R] [--model M] [--driver D] [--timeout T] <ticket>...
       subcon wait [--timeout SEC] <id>...
       subcon run [--runner R] [--model M] [--driver D] [--timeout T] <ticket>
       subcon resume [--timeout T] <id>
       subcon show <id>
       subcon list [--all]
       subcon diff <id>
       subcon log <id>
       subcon apply <id>
       subcon commit -m <message> [--edited] <id>
       subcon reject -m <reason> [--model M] [--runner R] <id>
       subcon discard <id>...
       subcon stats [--all] [--since <N>d|<N>h] [--text]
       subcon guide
       subcon trailer [--model M]

exit: 0 ok / 1 usage / 2 partial or blocked / 3 check failed / 4 job failed / 5 wait timed out
USAGE
  exit 1
}

command -v jq >/dev/null || die "jq not found"

cmd="${1:-}"
[[ $# -gt 0 ]] && shift
case "$cmd" in
  new) cmd_new "$@" ;;
  guide) cmd_guide "$@" ;;
  submit) cmd_submit "$@" ;;
  wait) cmd_wait "$@" ;;
  run) cmd_run "$@" ;;
  resume) cmd_resume "$@" ;;
  show) cmd_show "$@" ;;
  list) cmd_list "$@" ;;
  diff) cmd_diff "$@" ;;
  log) cmd_log "$@" ;;
  apply) cmd_apply "$@" ;;
  commit) cmd_commit "$@" ;;
  reject) cmd_reject "$@" ;;
  discard) cmd_discard "$@" ;;
  stats) cmd_stats "$@" ;;
  trailer) cmd_trailer "$@" ;;
  __exec) job_exec "$@" ;;
  *) usage ;;
esac
